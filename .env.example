# Copy to .env for local development. Never commit .env.
# In production set the same names in Vercel -> Project -> Settings -> Environment Variables,
# and OPENAI_API_KEY in GitHub -> Settings -> Secrets -> Actions (for the daily refresh).

OPENAI_API_KEY=
# Optional locally (logs go to data/local_log.jsonl without it). Required in production.
DATABASE_URL=
# Long random string; keys the visitor hash in logs so it can't be turned back into an IP address.
# Optional locally (a fixed dev value is used). Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SALT=
